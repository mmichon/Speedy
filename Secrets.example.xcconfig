// Secrets.example.xcconfig — template for local API keys.
//
// Setup:
//   1. Copy this file to Secrets.xcconfig (which is gitignored).
//   2. Fill in your own API keys below.
//
// The keys are injected into Info.plist at build time via the
// HereApiKey / TomTomApiKey entries ($(HERE_API_KEY) / $(TOMTOM_API_KEY)).
// See HERE_API_SETUP.md for obtaining a HERE key.
HERE_API_KEY =
TOMTOM_API_KEY =
